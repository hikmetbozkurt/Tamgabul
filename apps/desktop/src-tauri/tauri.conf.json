{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamgabul",
  "version": "0.1.0",
  "identifier": "dev.tamgabul.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Tamgabul",
        "url": "index.html?surface=widget",
        "width": 560,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "app",
        "title": "Tamgabul",
        "url": "index.html?surface=app",
        "width": 1366,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Find local files by describing them, completely offline.",
    "longDescription": "Tamgabul is a local-only desktop widget that finds files in your granted folders by meaning, words, text in images, and file names using local models.",
    "copyright": "Copyright 2026 Tamgabul Contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "notices/LICENSE",
      "../../../NOTICE": "notices/NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "notices/THIRD_PARTY_NOTICES.md",
      "../../../docs/HELP.md": "docs/HELP.md",
      "../../../docs/HELP.tr.md": "docs/HELP.tr.md"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "tr-TR"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
