{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Both windows: core defaults, custom title bar actions, native file/folder picker. No shell, fs or http plugins.",
  "windows": ["widget", "app"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "dialog:allow-open"
  ]
}
